# Copy this file to `.env` (same folder) and fill in what you have.
# `.env` is ignored by git, so your keys never get uploaded.

# SEC asks every automated visitor to say who they are, with an email.
# Example format: "Ripple research tool your-email@example.com"
SEC_USER_AGENT=

# Claude API key from https://console.anthropic.com (set a monthly spend limit there first!)
ANTHROPIC_API_KEY=
# Set to 1 to allow the AI jobs to actually call Claude. Leave empty to keep them off.
RIPPLE_AI_ENABLED=

# Korea's OpenDART key (free, https://opendart.fss.or.kr) and its on/off switch
OPENDART_API_KEY=
RIPPLE_OPENDART_ENABLED=

# Japan's EDINET key (free, https://api.edinet-fsa.go.jp) and its on/off switch
EDINET_API_KEY=
RIPPLE_EDINET_ENABLED=

# Ship tracking (later phase)
AISSTREAM_API_KEY=
